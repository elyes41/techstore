# À copier sur le serveur en /opt/techstore/.env  (chmod 600) — ne jamais le versionner
DOMAIN=techstore.tn
ACME_EMAIL=vous@exemple.com
# rempli automatiquement par le pipeline (registre GitLab ou ghcr.io)
REGISTRY=registry.gitlab.com/votre-groupe/techstore
TAG=latest

MONGO_USER=techstore
MONGO_PASSWORD=changez-moi-mot-de-passe-long
ADMIN_EMAIL=admin@techstore.tn
ADMIN_PASSWORD=changez-moi-aussi
WHATSAPP_NUMBER=

# E-mails (ex. adresse e-mail OVH : SMTP ssl0.ovh.net port 465 SSL)
MAIL_FROM=TechStore <no-reply@techstore.tn>
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=DISABLED
SMTP_USER=no-reply@techstore.tn
SMTP_PASSWORD=
